# Dockerfile for Rust profiling with cargo-flamegraph
FROM ubuntu:24.04

# Avoid timezone prompts
ENV DEBIAN_FRONTEND=noninteractive

# Install dependencies including perf-tools
RUN apt-get update && apt-get install -y \
    curl \
    build-essential \
    git \
    python3 \
    linux-tools-generic \
    linux-tools-common \
    && rm -rf /var/lib/apt/lists/*

# Install Rust
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
ENV PATH="/root/.cargo/bin:${PATH}"

# Install inferno (flamegraph generator that preserves symbols better)
RUN cargo install inferno

# Install addr2line and other symbol tools
RUN cargo install addr2line

# Fix perf for WSL2 kernel - symlink generic tools to the running kernel version
RUN set -eux; \
    tools_root="/usr/lib/linux-tools"; \
    wsl_kernel="$(uname -r)"; \
    mkdir -p "${tools_root}/${wsl_kernel}"; \
    source_dir="$(ls -1 "${tools_root}" | grep -v 'microsoft-standard-WSL2' | head -n 1 || true)"; \
    if [ -n "${source_dir}" ] && [ -d "${tools_root}/${source_dir}" ]; then \
        ln -sf "${tools_root}/${source_dir}"/* "${tools_root}/${wsl_kernel}/"; \
    else \
        echo "No linux-tools directory found under ${tools_root}; perf may not work under WSL2."; \
    fi

# Set working directory
WORKDIR /workspace

# The project will be mounted as a volume
# Usage:
#   docker build -f Dockerfile.profiling -t neural-net-profiler .
#   docker run --privileged -v ${PWD}:/workspace -v D:\temp\neural_net_profiling:/output -it neural-net-profiler
#
# Then inside container:
#   ./profile_in_docker.sh

CMD ["/bin/bash"]
